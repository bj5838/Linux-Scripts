#!/bin/bash
# 02_find_persistence.sh — Blue Team 1 READ-ONLY hunt for common Red Team persistence.
# Changes nothing. Run as root on each Linux host.
# Usage: sudo ./find_persistence.sh [days] | tee /root/persist_$(hostname).txt
#   days = how far back "recently changed" looks (default 3)
set -uo pipefail

[[ $EUID -eq 0 ]] || { echo "Run as root"; exit 1; }
DAYS=${1:-3}
section() { printf '\n=== %s ===\n' "$1"; }

section "Listening sockets (check every process/port is expected)"
ss -tulpn

section "Established connections (look for unknown remote IPs)"
ss -tnp state established

section "Cron: system"
ls -la /etc/cron.d /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly 2>/dev/null
grep -v '^#' /etc/crontab

section "Cron: per-user"
for f in /var/spool/cron/crontabs/*; do
  [[ -f "$f" ]] && { echo "--- $f"; cat "$f"; }
done 2>/dev/null

section "systemd timers"
systemctl list-timers --all --no-pager

section "Custom service units in /etc/systemd/system"
find /etc/systemd/system -maxdepth 2 -type f -name '*.service' -ls 2>/dev/null

section "Unit files changed in last $DAYS days"
find /etc/systemd/system /usr/lib/systemd/system -type f -mtime -"$DAYS" -ls 2>/dev/null

section "Shell startup files changed in last $DAYS days (system)"
find /etc/profile /etc/bash.bashrc /etc/environment /etc/profile.d -type f -mtime -"$DAYS" -ls 2>/dev/null

section "Shell startup files changed in last $DAYS days (users)"
find /root /home -maxdepth 2 -type f \( -name '.bashrc' -o -name '.profile' -o -name '.bash_profile' -o -name '.bash_login' -o -name '.bash_logout' \) -mtime -"$DAYS" -ls 2>/dev/null

section "ld.so.preload / LD_PRELOAD"
if [[ -e /etc/ld.so.preload ]]; then echo "EXISTS (unusual):"; cat /etc/ld.so.preload; else echo "no /etc/ld.so.preload"; fi
grep -la LD_PRELOAD /proc/[0-9]*/environ 2>/dev/null || echo "no process with LD_PRELOAD"

section "Running processes whose binary was deleted"
ls -l /proc/[0-9]*/exe 2>/dev/null | grep '(deleted)' || echo "none"

section "Executable files in /tmp /var/tmp /dev/shm"
find /tmp /var/tmp /dev/shm -type f -perm /111 -ls 2>/dev/null || true

section "PAM modules that execute commands"
grep -rnE 'pam_exec|pam_python' /etc/pam.d 2>/dev/null || echo "none"

section "PAM / NSS / SSH config changed in last $DAYS days"
find /etc/pam.d /etc/nsswitch.conf /etc/ssh -type f -mtime -"$DAYS" -ls 2>/dev/null

section "sshd tricks (command hooks, forced commands, Match blocks)"
grep -RinE 'AuthorizedKeysCommand|ForceCommand|^\s*Match' /etc/ssh/sshd_config /etc/ssh/sshd_config.d 2>/dev/null || echo "none"

section "SUID/SGID files (compare against a clean host of the same OS)"
find / -xdev \( -perm -4000 -o -perm -2000 \) -type f -ls 2>/dev/null

section "World-writable files in system directories"
find /etc /usr /lib /opt -xdev -type f -perm -0002 -ls 2>/dev/null

section "Installed files that differ from their .deb (possible trojaned binaries)"
dpkg -V 2>/dev/null | grep -v ' c /' || echo "none"

section "/etc/hosts and resolv.conf"
cat /etc/hosts /etc/resolv.conf

if command -v docker >/dev/null 2>&1; then
  section "Docker containers"
  docker ps -a --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
  section "Docker: privileged / host-PID / bind-mounted running containers"
  docker ps -q | xargs -r docker inspect --format '{{.Name}} privileged={{.HostConfig.Privileged}} pid={{.HostConfig.PidMode}} binds={{.HostConfig.Binds}}'
fi

echo
echo "Hunt done. Nothing was changed. Investigate before deleting; some hits are normal."
